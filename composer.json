{
    "name": "librebooking/librebooking",
    "description": "LibreBooking",
    "license": "GPL-3.0-only",
    "autoload": {
        "psr-4": {
            "LibreBooking\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LibreBooking\\Tests\\": "tests/src/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "squizlabs/php_codesniffer": "^3.13.6",
        "phpcompatibility/php-compatibility": "^9.3.5",
        "phpunit/phpunit": "^11.3",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require": {
        "php": ">=8.2",
        "smarty/smarty": "^5.8",
        "stripe/stripe-php": "^21.3",
        "monolog/monolog": "^3.11",
        "google/recaptcha": "1.3.*",
        "gregwar/captcha": "^2.1",
        "google/apiclient": "^2.19",
        "microsoft/microsoft-graph": "^3.5",
        "joelbutcher/facebook-graph-sdk": "^6.1",
        "mobiledetect/mobiledetectlib": "^4.11",
        "bacon/bacon-qr-code": "^3.1",
        "mibe/feedwriter": "^1.1",
        "sabre/vobject": "^5.0",
        "egulias/email-validator": "^4.0",
        "phpmailer/phpmailer": "^7.1",
        "claviska/simpleimage": "^4.2",
        "mashape/unirest-php": "^3.0",
        "vlucas/phpdotenv": "^5.7",
        "pear/net_ldap2": "^2.3",
        "ext-intl": "*",
        "ext-ldap": "*",
        "symfony/html-sanitizer": "^7.4",
        "league/uri": "^7.8"
    },
    "scripts": {
        "install-tools": "phive install --trust-gpg-keys",
        "build": "./tools/phing",
        "phpcsfixer:fix": "./vendor/bin/php-cs-fixer fix -v",
        "phpcsfixer:lint": "./vendor/bin/php-cs-fixer fix -vv --dry-run",
        "phpunit": "./vendor/bin/phpunit",
        "phpstan": "./vendor/bin/phpstan analyse",
        "phpstan_next": "./vendor/bin/phpstan analyse -c phpstan_next.neon",
        "phpstan:baseline": "./vendor/bin/phpstan analyze --generate-baseline",
        "test": [
            "@phpunit",
            "@phpcsfixer:lint"
        ],
        "sniffer:php8": "phpcs -p ./ --standard=vendor/phpcompatibility/php-compatibility/PHPCompatibility --report-full=./php8-report.log --ignore=./vendor/*,./tools/*,./.git/*,./tpl_c/*,./build/*,./.phpdoc/*,./var/*,./Web/scripts/*,./Web/css/* --runtime-set testVersion 8.0",
        "preflight": "php lib/preflight.php",
        "test:integration": "./vendor/bin/phpunit --testsuite integration --testdox",
        "config-dist:generate": "php scripts/generate-config-dist.php --write",
        "config-dist:check": "php scripts/generate-config-dist.php --check",
        "env-example:generate": "php scripts/generate-env-example.php --write",
        "env-example:check": "php scripts/generate-env-example.php --check"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "platform": {
            "php": "8.2.0"
        }
    }
}
